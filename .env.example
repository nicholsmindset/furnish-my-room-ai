# ==========================================
# RoomReimagine Environment Variables
# ==========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ==========================================
# FRONTEND (Vite) - Required for client-side
# ==========================================

# Supabase Project URL (from Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anon/Public Key (from Supabase Dashboard > Settings > API)
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI..."

# Supabase Project ID (the part before .supabase.co in your URL)
VITE_SUPABASE_PROJECT_ID="your-project-id"

# ==========================================
# BACKEND (Supabase Edge Functions) - Required for server-side
# ==========================================
# These are set in Supabase Dashboard > Edge Functions > Secrets

# Supabase Service Role Key (from Supabase Dashboard > Settings > API)
# WARNING: This key has admin privileges - keep it secret!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI..."

# Supabase Anon Key (same as VITE_SUPABASE_PUBLISHABLE_KEY)
# Used by edge functions to call other edge functions
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI..."

# ==========================================
# FAL.AI - Required for AI image generation
# ==========================================

# FAL.AI API Key (from https://fal.ai/dashboard/keys)
FAL_KEY="fal_..."

# ==========================================
# STRIPE - Required for payments
# ==========================================

# Stripe Secret Key (from Stripe Dashboard > Developers > API keys)
# Use test key (sk_test_...) for development, live key (sk_live_...) for production
STRIPE_SECRET_KEY="sk_test_..."

# Stripe Webhook Secret (from Stripe Dashboard > Developers > Webhooks)
# Create a webhook endpoint pointing to your-url/functions/v1/stripe-webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# ==========================================
# RESEND - Required for email notifications
# ==========================================

# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY="re_..."

# ==========================================
# OPTIONAL
# ==========================================

# Site URL for email links (defaults to request origin)
# SITE_URL="https://your-domain.com"
